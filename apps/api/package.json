{
	"name": "@2do/api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"deploy": "vp build && wrangler deploy --var ACCESS_ISSUER:\"$ACCESS_ISSUER\" --var ACCESS_AUD:\"$ACCESS_AUD\"",
		"format": "vp fmt",
		"test": "node ../../scripts/test-api.mjs",
		"typecheck": "wrangler types && tsc -p tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"eval:plugins": "node evals/planner-plugins.mjs",
		"eval:meal": "node evals/meal.mjs",
		"eval:copilot": "vp build && node evals/copilot.mjs"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.39.2",
		"@cloudflare/vitest-plugin": "^1.8.3",
		"@flue/sdk": "^2.3.1",
		"@flue/vite": "^2.3.1",
		"@types/web-push": "^3.6.4",
		"drizzle-kit": "^0.31.11",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0",
		"wrangler": "^4.113.0"
	},
	"engines": {
		"node": "^22.23.0 || ^24.22.0 || ^26.12.0"
	},
	"dependencies": {
		"@cfworker/json-schema": "4.1.6",
		"@flue/runtime": "^2.3.1",
		"@googleapis/calendar": "^20.2.0",
		"@googleapis/gmail": "^22.1.0",
		"@googleapis/health": "^7.0.2",
		"@hono/zod-openapi": "^1.6.3",
		"@js-temporal/polyfill": "^0.5.1",
		"@modelcontextprotocol/client": "2.0.0",
		"@modelcontextprotocol/server": "2.0.0",
		"drizzle-orm": "^0.45.4",
		"google-auth-library": "^11.3.4",
		"hono": "^4.13.13",
		"jose": "^6.2.12",
		"valibot": "^1.5.0",
		"web-push": "^3.6.7",
		"zod": "^4.6.7"
	},
	"exports": {
		"./connectors": "./src/interfaces/connectors.ts",
		"./goals": "./src/interfaces/goals.ts",
		"./notebook": "./src/interfaces/notebook.ts",
		"./plan": "./src/interfaces/plan.ts",
		"./task-plugins": "./src/interfaces/task-plugins.ts",
		"./plugin-reports": "./src/interfaces/plugin-reports.ts",
		"./task-summaries": "./src/interfaces/task-summaries.ts",
		"./agents-workspace": "./src/interfaces/agents-workspace.ts",
		"./chats": "./src/interfaces/chats.ts",
		"./workspace-command": "./src/interfaces/workspace-command.ts",
		"./agent-inbox": "./src/interfaces/agent-inbox.ts",
		"./reminders": "./src/interfaces/reminders.ts"
	}
}
