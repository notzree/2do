  {
    "name": "proposeTime",
    "description": "Propose moving a fixed event for user review. The accepted schedule stays in place.",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "requestBody": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Stable ID for retries of this proposal"
            },
            "taskId": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "after": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "fixed"
                  ]
                },
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "type",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "id",
            "taskId",
            "revision",
            "after",
            "reason"
          ],
          "additionalProperties": false,
          "description": "The JSON request body."
        }
      },
      "required": [
        "requestBody"
      ]
    },
    "method": "post",
    "pathTemplate": "/api/review",
    "requestBodyContentType": "application/json"
  },
  {
    "name": "readPage",
    "description": "Read a day document",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "date"
      ]
    },
    "method": "get",
    "pathTemplate": "/api/days/{date}"
  },
  {
    "name": "writePage",
    "description": "Save a day at its reviewed revision and create embedded tasks atomically",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "requestBody": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "enum": [
                1
              ]
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "doc": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "doc"
                  ]
                },
                "content": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "paragraph",
                              "heading"
                            ]
                          },
                          "content": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "enum": [
                                    "text"
                                  ]
                                },
                                "text": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "marks": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "enum": [
                                          "strong",
                                          "em",
                                          "underline"
                                        ]
                                      }
                                    },
                                    "required": [
                                      "type"
                                    ],
                                    "additionalProperties": false
                                  },
                                  "maxItems": 3
                                }
                              },
                              "required": [
                                "type",
                                "text"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "taskRef",
                              "graphRef"
                            ]
                          },
                          "attrs": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid"
                              }
                            },
                            "required": [
                              "id"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "type",
                          "attrs"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "image"
                            ]
                          },
                          "attrs": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              },
                              "alt": {
                                "type": "string",
                                "maxLength": 240
                              }
                            },
                            "required": [
                              "id",
                              "alt"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "type",
                          "attrs"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 5000
                }
              },
              "required": [
                "type",
                "content"
              ],
              "additionalProperties": false
            },
            "newTasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "rawInput": {
                    "type": "string",
                    "maxLength": 4000,
                    "pattern": "\\S",
                    "description": "Verbatim task body after the slash command."
                  },
                  "typeId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}\\.[a-z][a-z0-9-]{0,63}$",
                    "description": "Explicitly attach an enabled subtype with a capture command."
                  },
                  "captureDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Local calendar date when the user entered the task."
                  },
                  "timeZone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": false
              },
              "maxItems": 500
            }
          },
          "required": [
            "version",
            "revision",
            "doc",
            "newTasks"
          ],
          "additionalProperties": false,
          "description": "The JSON request body."
        }
      },
      "required": [
        "date",
        "requestBody"
      ]
    },
    "method": "put",
    "pathTemplate": "/api/days/{date}",
    "requestBodyContentType": "application/json"
  },
  {
    "name": "searchTasks",
    "description": "Find matching tasks by title, completion, calendar day or timed interval. Page through results using nextCursor.",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "requestBody": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "completed": {
              "type": "boolean"
            },
            "date": {
              "type": "string",
              "format": "date",
              "description": "Match floating tasks on this calendar day. Combine with an interval to also match timed commitments."
            },
            "interval": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false,
              "description": "Match fixed times and windows overlapping this half-open interval. Use the local midnight offsets for a calendar day."
            },
            "after": {
              "type": "string",
              "format": "uuid",
              "description": "Cursor from the previous result"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          "additionalProperties": false,
          "description": "The JSON request body."
        }
      },
      "required": [
        "requestBody"
      ]
    },
    "method": "post",
    "pathTemplate": "/api/tasks/search",
    "requestBodyContentType": "application/json"
  },
  {
    "name": "listTasks",
    "description": "Read the plan in prerequisite-first order",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "method": "get",
    "pathTemplate": "/api/tasks"
  },
  {
    "name": "createTask",
    "description": "Create a task, optionally splicing it before or after an anchor",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "requestBody": {
          "type": "object",
          "properties": {
            "parentId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "default": null
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "kind": {
              "type": "string",
              "enum": [
                "task",
                "event",
                "milestone"
              ],
              "default": "task"
            },
            "completed": {
              "type": "boolean",
              "default": false
            },
            "schedule": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "day"
                      ]
                    },
                    "date": {
                      "type": "string",
                      "format": "date"
                    }
                  },
                  "required": [
                    "type",
                    "date"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "fixed"
                      ]
                    },
                    "start": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "end": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "type",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "window"
                      ]
                    },
                    "start": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "end": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "type",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "An all-day date or a half-open interval with end later than start."
            },
            "durationMinutes": {
              "type": [
                "integer",
                "null"
              ],
              "exclusiveMinimum": 0,
              "maximum": 525600,
              "default": null
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Client-assigned ID. Reusing an existing ID returns 409."
            },
            "placement": {
              "type": "object",
              "properties": {
                "side": {
                  "type": "string",
                  "enum": [
                    "before",
                    "after"
                  ]
                },
                "anchor": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "side",
                "anchor"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "description": "The JSON request body."
        }
      },
      "required": [
        "requestBody"
      ]
    },
    "method": "post",
    "pathTemplate": "/api/tasks",
    "requestBodyContentType": "application/json"
  },
  {
    "name": "getTask",
