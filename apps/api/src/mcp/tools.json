  {
    "name": "writeTaskSubtype",
    "description": "Attach or replace subtype data at its current revision, or reject it with null data",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "typeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}\\.[a-z][a-z0-9-]{0,63}$"
        },
        "requestBody": {
          "type": "object",
          "properties": {
            "revision": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "data": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {}
            }
          },
          "required": [
            "revision",
            "data"
          ],
          "additionalProperties": false,
          "description": "The JSON request body."
        }
      },
      "required": [
        "id",
        "typeId",
        "requestBody"
      ]
    },
    "method": "put",
    "pathTemplate": "/api/tasks/{id}/subtypes/{typeId}",
    "requestBodyContentType": "application/json"
  },
