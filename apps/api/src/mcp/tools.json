  {
    "name": "deleteTask",
    "description": "Delete the task, its incident edges and its references on every notebook page",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "withPages": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Delete only the task revision the caller reviewed."
        }
      },
      "required": [
        "id"
      ]
    },
    "method": "delete",
    "pathTemplate": "/api/tasks/{id}",
    "queryParameters": [
      "withPages",
      "expectedRevision"
    ]
  },
