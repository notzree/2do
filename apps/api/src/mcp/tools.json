  {
    "name": "addDependency",
    "description": "Require from to finish before to starts",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "uuid"
        },
        "to": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Plan revision reviewed by the caller. An already-applied change succeeds at any revision."
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "method": "put",
    "pathTemplate": "/api/dependencies/{from}/{to}",
    "queryParameters": [
      "expectedRevision"
    ]
  },
